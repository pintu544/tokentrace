# TokenTrace API env — copy to server/.env (never commit it).
# Full checklist for production is in docs/DEPLOY.md.

# ---- Runtime ----
PORT=4000
NODE_ENV=development            # set to "production" on Azure

# ---- Database ----
# Local dev: point at a real Postgres (tests use in-memory pg-mem, no DB needed).
# Production (Azure Database for PostgreSQL Flexible Server):
#   postgres://ttadmin:<password>@tokentrace-db.postgres.database.azure.com:5432/tokentrace?sslmode=require
DATABASE_URL=postgres://tokentrace:tokentrace@localhost:5432/tokentrace

# ---- Dashboard auth ----
# REQUIRED in production (the app refuses to boot without it). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---- Upstream LLM / AI API ----
# The API your customers' calls are forwarded to.
# Mock mode (no keys needed): MOCK_UPSTREAM=true returns canned responses.
MOCK_UPSTREAM=true
# Production: base URL + server-side key (injected as Authorization: Bearer;
# never exposed to customers). Example: Perfect Corp YouCam.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=

# ---- Stripe (test mode for the hackathon; live keys only if you go real) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
# or the Stripe dashboard (Developers → Webhooks).
STRIPE_WEBHOOK_SECRET=

# ---- Security ----
# Comma-separated browser origins allowed to call the API directly.
# Empty = default deny. The Next.js dashboard calls the API server-side,
# so this normally stays empty.
CORS_ORIGIN=
# Max size (MB) for non-JSON request bodies on the REST passthrough
# (image uploads etc.). JSON bodies are capped at 2mb separately.
REST_BODY_LIMIT_MB=10

# ---- Seed ----
# Used by `npm run seed` to create the first admin user. Omit ADMIN_PASSWORD
# to get a random one printed once.
ADMIN_EMAIL=admin@tokentrace.local
# ADMIN_PASSWORD=
