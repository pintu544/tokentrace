# Copy to server/.env (or export in your shell). Never commit .env.
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/tokentrace

# Upstream API. Serves BOTH proxy modes (server-side only — never exposed):
#  - OpenAI-compatible chat completions (POST /v1/proxy/chat/completions)
#  - Generic REST passthrough (ANY /v1/proxy/upstream/*), e.g. Perfect Corp YouCam.
# Leave blank with MOCK_UPSTREAM for local dev.
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
# 'true' = canned response WITH usage block · 'no-usage' = canned response WITHOUT usage block
MOCK_UPSTREAM=true

# Dashboard auth (Slice 3)
JWT_SECRET=change-me-in-production

# Stripe test mode (Slice 4). STRIPE_WEBHOOK_SECRET comes from `stripe listen`
# or the dashboard (Developers → Webhooks → Add endpoint → Signing secret).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Seed admin (npm run seed)
ADMIN_EMAIL=admin@tokentrace.local
ADMIN_PASSWORD=

# Dashboard (dashboard/.env.local) — the browser never calls the API directly;
# Next.js route handlers proxy with the session JWT, so no CORS is needed.
API_URL=http://localhost:4000
